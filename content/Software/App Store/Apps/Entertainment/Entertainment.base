filters:
  and:
    - file.tags.contains("app/entertainment")
properties:
  note.app category:
    displayName: Category
  note.age rating:
    displayName: Age Rating
  note.developer:
    displayName: Developer
views:
  - type: cards
    name: Apps
    order:
      - file.name
      - app category
      - developer
      - age rating
    image: note.app icon
    cardSize: 150
    imageAspectRatio: 1
