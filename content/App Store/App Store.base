views:
  - type: list
    name: Pages
    filters:
      or:
        - and:
            - file.folder == "App Store"
            - file.ext != "base"
            - file.ext != "png"
        - file.folder == "App Store/Apps"
    order:
      - file.basename
      - file.name
    indentProperties: false
    separator: ": "
  - type: cards
    name: Apps
    filters:
      and:
        - file.tags.contains("app")
    order:
      - file.name
      - app category
      - age rating
      - Developer
    image: note.app icon
    cardSize: 150
